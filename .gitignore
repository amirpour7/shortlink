# Dependencies
node_modules/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test coverage and reports
coverage/
.nyc_output/

# Local SQLite databases and runtime database files
# Keep the database schema and application code under version control,
# but do not commit local user data.
data/*.sqlite
data/*.sqlite3
data/*.db
data/*.sqlite-*
data/*.db-*

# Runtime process files
*.pid
*.pid.lock

# Build and temporary output
/dist/
/build/
.tmp/
.temp/
.cache/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local backups and swap files
*.bak
*.swp
*.swo
*~
