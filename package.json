{
  "name": "express-health-api",
  "version": "1.3.3",
  "description": "A documented Express URL shortener with SQLite, dotenv, Swagger UI, Tailwind CSS frontend, security middleware, and tests.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --audit-level=moderate",
    "demo": "node test-script.js",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./public/assets/style.css --minify",
    "dev:css": "npx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./public/assets/style.css --watch",
    "build": "npm run build:css",
    "test:docs": "node --test tests/swagger.test.js",
    "test:proxy": "node --test tests/proxy.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "api",
    "health-check",
    "url-shortener",
    "sqlite",
    "swagger",
    "openapi",
    "postman"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "nodemon": "^3.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
