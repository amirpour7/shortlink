# Copy this file to .env and adjust the values for your environment.
# Do not commit .env or put production secrets in source control.
NODE_ENV=development
PORT=3000

# Public origin used in generated short URLs. Production must use HTTPS.
SHORT_URL_BASE=http://localhost:3000

# SQLite database file. Relative paths are resolved from the project root.
SHORTENER_DB_PATH=./data/urls.sqlite

# Maximum JSON request body size accepted by POST /shorten.
JSON_BODY_LIMIT=8kb

# Rate limiting settings.
SHORTEN_RATE_LIMIT_WINDOW_MS=60000
SHORTEN_RATE_LIMIT_MAX=10
SHORT_CODE_LOOKUP_RATE_LIMIT_MAX=300

# Number of trusted reverse proxies in front of Express.
# Leave blank to use the environment default: 0 in development, 1 in production.
# Override with the exact trusted hop count if your hosting proxy chain differs.
# Never use "true"; trust only the exact proxy hop count.
TRUST_PROXY_HOPS=

# Optional exact host allowlist for redirect destinations (comma-separated).
# Empty means any syntactically valid HTTP/HTTPS destination is accepted.
# SHORTENER_ALLOWED_HOSTS=example.com,docs.example.org
SHORTENER_ALLOWED_HOSTS=

# Expose the interactive Swagger UI and OpenAPI JSON endpoint.
SWAGGER_ENABLED=true
